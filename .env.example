# ============================================================================================================================
#                           Dastan Experiences — Environment Variables
# ============================================================================================================================

# 1. Supabase Postgres & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key


# 2. Razorpay Payment Gateway (Test Mode)
# In Razorpay Dashboard -> Settings -> API Keys -> Generate Test Key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# In Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key


# 3. Resend Transactional Email (Optional - Fallback to console simulation)
RESEND_API_KEY=re_your_resend_api_key


# 4. App Canonical URL
NEXT_PUBLIC_APP_URL=http://localhost:3000


# 5. Executive Master Admin Passkey (PIN to unlock Admin Console)
NEXT_PUBLIC_ADMIN_PIN=8899
